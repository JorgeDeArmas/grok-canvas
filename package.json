{
  "name": "grok-canvas",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:portal && npm run test:secrets",
    "test:unit": "node --test tests/static/*.test.mjs",
    "test:portal": "node tests/run-portal.mjs",
    "test:pw": "playwright test",
    "test:secrets": "bash scripts/check-secrets.sh",
    "icons": "node scripts/vendor-icons.mjs && node scripts/make-icons.mjs",
    "icons:check": "node scripts/vendor-icons.mjs --check && node scripts/make-icons.mjs --check",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.10.3",
    "lucide-static": "0.468.0",
    "playwright": "^1.55.1"
  }
}
