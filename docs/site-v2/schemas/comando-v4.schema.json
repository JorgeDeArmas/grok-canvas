{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jorgedearmas.github.io/grok-canvas/docs/site-v2/schemas/comando-v4.schema.json",
  "title": "Root scene comando v4 (Dashboard + Grabar + Creadoras)",
  "description": "Plaintext shape BEFORE AES-GCM sealing. Generators validate against this; viewers still sanitize every field. See ARCHITECTURE.md §7.2.",
  "type": "object",
  "required": ["type", "version", "updatedAt", "tasks", "products", "videos", "creators"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "comando" },
    "version": { "const": 4 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "mailbox": { "$ref": "#/$defs/uuid" },
    "portalApi": { "type": "string", "pattern": "^https://[a-z0-9-]+(\\.[a-z0-9-]+)*\\.workers\\.dev/?$" },
    "managerToken": { "$ref": "#/$defs/token" },
    "ownerToken": { "$ref": "#/$defs/token" },
    "keyring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boards": { "$ref": "#/$defs/ref" },
        "feed": {
          "allOf": [{ "$ref": "#/$defs/ref" }],
          "properties": { "b": true, "k": true, "f": { "$ref": "#/$defs/uuid" } },
          "unevaluatedProperties": false
        },
        "filming": { "$ref": "#/$defs/ref" }
      }
    },
    "thumbs": {
      "type": "object",
      "maxProperties": 60,
      "propertyNames": { "pattern": "^[A-Za-z0-9_:.-]{1,40}$" },
      "additionalProperties": { "type": "string", "pattern": "^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$", "maxLength": 60000 }
    },
    "tasks": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/task" } },
    "products": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/product" } },
    "videos": { "type": "array", "maxItems": 80, "items": { "$ref": "#/$defs/video" } },
    "ticks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/videoId" },
      "additionalProperties": {
        "type": "array", "prefixItems": [{ "enum": [0, 1] }, { "type": "integer", "minimum": 0 }], "items": false, "minItems": 2
      }
    },
    "brands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label", "items"],
            "properties": {
              "id": { "enum": ["waiting", "closed", "negotiating", "other"] },
              "label": { "$ref": "#/$defs/text60" },
              "items": {
                "type": "array", "maxItems": 30,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "title"],
                  "properties": {
                    "id": { "$ref": "#/$defs/itemId" },
                    "title": { "$ref": "#/$defs/name" },
                    "meta": { "$ref": "#/$defs/text80" },
                    "since": { "$ref": "#/$defs/date" },
                    "mail": { "$ref": "#/$defs/mail" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "grok": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/$defs/itemId" },
          "title": { "$ref": "#/$defs/text80" },
          "meta": { "$ref": "#/$defs/text80" },
          "thumb": { "$ref": "#/$defs/thumbKey" },
          "icon": { "enum": ["search", "pen-line", "hourglass", "clapperboard", "scissors", "sparkles"] },
          "detail": { "$ref": "#/$defs/detail" }
        }
      }
    },
    "creators": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/session" } },
    "scripts": {
      "type": "object",
      "propertyNames": { "pattern": "^ff-\\d{3}$" },
      "additionalProperties": { "$ref": "#/$defs/scriptSet" }
    },
    "alerts": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/itemId" },
          "text": { "type": "string", "minLength": 1, "maxLength": 140, "not": { "pattern": "\\b[Bb][Ee][Ll][Ll][Aa]\\b" } },
          "tone": { "enum": ["info", "warn", "bad"] }
        }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,256}$" },
    "blob": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "ref": {
      "type": "object", "required": ["b", "k"],
      "properties": { "b": { "$ref": "#/$defs/blob" }, "k": { "$ref": "#/$defs/key" } }
    },
    "itemId": { "type": "string", "pattern": "^[A-Za-z0-9:_.-]{1,120}$" },
    "pid": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
    "videoId": { "type": "string", "pattern": "^rec:[a-z0-9]{2,24}$" },
    "jobRef": { "type": "string", "pattern": "^ff-\\d{3}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "day": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2}|sin-fecha)$" },
    "thumbKey": { "type": "string", "pattern": "^[A-Za-z0-9_:.-]{1,40}$" },
    "lane": { "enum": ["miamix", "bella", "creadoras"] },
    "tone": { "enum": ["neutral", "accent", "good", "warn", "bad", "info", "teal"] },
    "noCodes": {
      "description": "Human text: no internal codes, no Bella, no raw ISO dates, no paths.",
      "not": { "pattern": "(\\b[Ff][Ff]-\\d{3}\\b|\\b[Jj][Oo][Bb]-\\d+\\b|\\b[Bb][Ee][Ll][Ll][Aa]\\b|\\d{4}-\\d{2}-\\d{2}|/Users/|~/|\\.json\\b)" }
    },
    "name": {
      "allOf": [
        { "type": "string", "minLength": 2, "maxLength": 60 },
        { "$ref": "#/$defs/noCodes" },
        { "not": { "pattern": "^([Pp]roducto|[Vv]ideo|[Ii]tem|[Mm]arca)$" } }
      ]
    },
    "text60": { "allOf": [{ "type": "string", "maxLength": 60 }, { "$ref": "#/$defs/noCodes" }] },
    "text80": { "allOf": [{ "type": "string", "maxLength": 80 }, { "$ref": "#/$defs/noCodes" }] },
    "detail": {
      "type": "array", "maxItems": 8,
      "items": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/text60" }, { "type": "string", "maxLength": 200 }], "items": false, "minItems": 2 }
    },
    "mail": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "web": { "type": "string", "pattern": "^https://mail\\.google\\.com/" },
        "search": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 120 }
      }
    },
    "videoStatus": { "enum": ["preparing", "to_film", "filmed", "editing", "to_publish", "published", "to_approve", "problem", "retired"] },
    "stage": { "enum": ["chosen", "sample_requested", "sample_shipping", "arrived", "researching", "pick_script", "preparing", "to_film", "filmed", "editing", "to_publish", "published", "brand_hold", "dropped"] },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["type", "label"],
      "properties": {
        "type": { "enum": ["done", "act", "scripts", "board", "link", "route", "mail"] },
        "label": { "type": "string", "minLength": 2, "maxLength": 24 },
        "id": { "$ref": "#/$defs/itemId" },
        "doneLabel": { "type": "string", "maxLength": 24 },
        "href": { "type": "string", "pattern": "^https://" },
        "route": { "enum": ["feed", "grabar", "creadoras", "boards"] },
        "board": { "type": "string", "maxLength": 40 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "act" } } }, "then": { "required": ["id"] } },
        { "if": { "properties": { "type": { "const": "link" } } }, "then": { "required": ["href"] } },
        { "if": { "properties": { "type": { "const": "route" } } }, "then": { "required": ["route"] } }
      ]
    },
    "task": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "title", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "kind": { "enum": ["pick_script", "publish", "sample", "brand_reply", "brand_decide", "brand_bounce", "deliver", "move_takes", "choose_products", "approve_media", "other"] },
        "title": { "$ref": "#/$defs/name" },
        "meta": { "$ref": "#/$defs/text80" },
        "thumb": { "$ref": "#/$defs/thumbKey" },
        "tone": { "$ref": "#/$defs/tone" },
        "product": { "$ref": "#/$defs/pid" },
        "video": { "$ref": "#/$defs/videoId" },
        "due": { "$ref": "#/$defs/date" },
        "action": { "$ref": "#/$defs/action" },
        "done": {
          "type": "object", "additionalProperties": false,
          "properties": { "label": { "type": "string", "maxLength": 24 } }
        },
        "detail": { "$ref": "#/$defs/detail" },
        "mail": { "$ref": "#/$defs/mail" },
        "open": {
          "type": "object", "additionalProperties": false, "required": ["scripts"],
          "properties": { "scripts": { "$ref": "#/$defs/jobRef" } }
        }
      }
    },
    "product": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "stage", "lane"],
      "properties": {
        "id": { "$ref": "#/$defs/pid" },
        "name": { "$ref": "#/$defs/name" },
        "thumb": { "$ref": "#/$defs/thumbKey" },
        "lane": { "$ref": "#/$defs/lane" },
        "stage": { "$ref": "#/$defs/stage" },
        "due": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "now": { "$ref": "#/$defs/text80" },
        "sample": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "state": { "enum": ["none", "requested", "shipping", "arrived"] },
            "eta": { "$ref": "#/$defs/date" }
          }
        },
        "pdp": { "type": "string", "pattern": "^https://(shop\\.tiktok\\.com|www\\.tiktok\\.com)/" },
        "videos": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/videoId" } },
        "detail": { "$ref": "#/$defs/detail" }
      }
    },
    "video": {
      "type": "object", "additionalProperties": false, "required": ["id", "product", "owner", "lane", "day", "status", "ready"],
      "properties": {
        "id": { "$ref": "#/$defs/videoId" },
        "job": { "type": "string", "pattern": "^(ff|FF)-\\d{3}$", "description": "Internal; never displayed." },
        "product": { "$ref": "#/$defs/pid" },
        "title": { "$ref": "#/$defs/text60" },
        "owner": { "enum": ["jorge", "creadoras"] },
        "lane": { "$ref": "#/$defs/lane" },
        "day": { "$ref": "#/$defs/day" },
        "place": { "type": "string", "maxLength": 24 },
        "status": { "$ref": "#/$defs/videoStatus" },
        "ready": { "type": "boolean" },
        "boardRef": { "$ref": "#/$defs/ref" },
        "takes": {
          "type": "object", "additionalProperties": false,
          "properties": { "total": { "type": "integer", "minimum": 0, "maximum": 99 }, "uploaded": { "type": "integer", "minimum": 0, "maximum": 99 } }
        }
      }
    },
    "session": {
      "type": "object", "additionalProperties": false, "required": ["id", "creatorName", "shootDate", "link", "jobs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "shootDate": { "$ref": "#/$defs/date" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["active", "expired", "revoked"] },
        "revoked": { "type": "boolean" },
        "link": { "type": "string", "pattern": "^https://jorgedearmas\\.github\\.io/grok-canvas/portal\\.html#", "maxLength": 2048, "not": { "pattern": "[#&]m=" } },
        "jobs": {
          "type": "array", "maxItems": 40,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["job_id", "name"],
            "properties": {
              "job_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,16}$" },
              "name": { "$ref": "#/$defs/name" },
              "thumb": { "$ref": "#/$defs/thumbKey" },
              "status": { "enum": ["sent", "opened", "uploading", "uploaded", "approved", "redo", "pulled"] },
              "board": { "$ref": "#/$defs/ref" }
            }
          }
        }
      }
    },
    "scriptSet": {
      "description": "Unchanged from hub v3 (README «hub.html v2»).",
      "type": "object",
      "required": ["job", "product", "options"],
      "properties": {
        "job": { "$ref": "#/$defs/jobRef" },
        "product": { "type": "string", "maxLength": 60 },
        "recommended": { "enum": ["A", "B", "C", ""] },
        "recommendedWhy": { "type": "string", "maxLength": 80 },
        "picked": { "enum": ["A", "B", "C", ""] },
        "pickedAt": { "type": "string" },
        "changeable": { "type": "boolean" },
        "thumb": { "$ref": "#/$defs/thumbKey" },
        "pdp": { "type": "string", "pattern": "^https://" },
        "options": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "required": ["letter", "hook"],
            "properties": {
              "letter": { "enum": ["A", "B", "C"] },
              "focus": { "type": "string", "maxLength": 80 },
              "framework": { "type": "string" },
              "frameworkEs": { "type": "string", "maxLength": 200 },
              "donor": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "properties": {
                      "handle": { "type": "string", "maxLength": 40 },
                      "url": { "type": "string", "pattern": "^https://www\\.tiktok\\.com/@[A-Za-z0-9._]+/video/\\d+$" }
                    }
                  }
                ]
              },
              "transfer": { "type": "string", "maxLength": 160 },
              "fill": { "type": "string", "maxLength": 160 },
              "cast": { "type": "string", "maxLength": 200 },
              "place": { "type": "string", "maxLength": 200 },
              "seconds": { "type": "number" },
              "hook": { "type": "string", "maxLength": 400 },
              "hookText": { "type": "string", "maxLength": 80 },
              "beats": {
                "type": "array", "maxItems": 30,
                "items": {
                  "type": "object",
                  "properties": {
                    "t": { "type": "string", "maxLength": 20 },
                    "vo": { "type": "string", "maxLength": 600 },
                    "visual": { "type": "string", "maxLength": 300 },
                    "text": { "type": "string", "maxLength": 80 }
                  }
                }
              },
              "teleprompter": { "type": "string", "maxLength": 3000 },
              "rules": { "type": "string", "maxLength": 400 }
            }
          }
        }
      }
    }
  }
}
